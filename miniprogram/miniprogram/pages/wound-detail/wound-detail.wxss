.asm-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.asm-date { font-size: 24rpx; color: #8E8E93; }
.metric-row { display: flex; margin-bottom: 16rpx; }
.metric { flex: 1; display: flex; flex-direction: column; align-items: center; }
.m-num { font-size: 36rpx; font-weight: 700; color: #0066CC; }
.m-lbl { font-size: 20rpx; color: #8E8E93; margin-top: 4rpx; }
.photo { width: 100%; height: 320rpx; border-radius: 16rpx; margin-bottom: 12rpx; }
.crf-line { font-size: 22rpx; color: #8E8E93; margin-bottom: 8rpx; }
.lock-line { font-size: 22rpx; color: #34C759; margin-top: 8rpx; }
.sm { font-size: 26rpx; padding: 4rpx 0; margin-top: 8rpx; }
