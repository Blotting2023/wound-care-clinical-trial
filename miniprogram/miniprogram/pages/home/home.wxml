<view class="wrap">
  <!-- 头部：角色标识 -->
  <view class="header">
    <view class="hello">
      <text class="hi">你好，{{user.displayName}}</text>
      <text class="role-tag" style="background: rgba(0,102,204,.1); color:#0066CC;">{{roleTag}}</text>
    </view>
    <view class="me-link" bindtap="goMy">我的</view>
  </view>

  <!-- ============ Sponsor 视图（GCP §5 仅聚合统计） ============ -->
  <block wx:if="{{view === 'sponsor'}}">
    <view class="card">
      <view class="stat-grid">
        <view class="stat"><text class="num">{{stats.subjects}}</text><text class="lbl">受试者总数</text></view>
        <view class="stat"><text class="num">{{stats.lockedAssessments}}</text><text class="lbl">已锁定</text></view>
        <view class="stat"><text class="num">{{stats.ongoing}}</text><text class="lbl">进行中</text></view>
      </view>
    </view>
    <view class="card note-card">
      <text class="note">GCP 数据最小化：监查方仅可见聚合统计，个体数据不可见。</text>
    </view>
  </block>

  <!-- ============ IRB 视图（GCP §6 仅伦理相关） ============ -->
  <block wx:elif="{{view === 'irb'}}">
    <view class="card">
      <view class="card-title">待审知情同意</view>
      <view wx:if="{{pendingConsents.length === 0}}" class="empty">暂无待审件</view>
      <view wx:for="{{pendingConsents}}" wx:key="_id" class="list-item" bindtap="goConsent">
        <view class="li-main">
          <text class="li-title">知情同意待审核</text>
          <text class="li-sub">{{item.uploadedBy}} · {{item.uploadedAt}}</text>
        </view>
        <text class="arrow">›</text>
      </view>
    </view>
  </block>

  <!-- ============ Admin 视图 ============ -->
  <block wx:elif="{{view === 'admin'}}">
    <view class="card" bindtap="goTrial">
      <view class="card-title">系统管理</view>
      <view class="list-item"><view class="li-main"><text class="li-title">试验管理（中心 / 方案 / 器械）</text></view><text class="arrow">›</text></view>
      <view class="list-item"><view class="li-main"><text class="li-title">受试者：{{stats.subjects}} · 中心：{{stats.centers}}</text></view></view>
    </view>
  </block>

  <!-- ============ 临床视图（PI/SubI/CRC） ============ -->
  <block wx:else>
    <view class="card">
      <view class="stat-grid">
        <view class="stat"><text class="num">{{stats.subjects}}</text><text class="lbl">受试者</text></view>
        <view class="stat"><text class="num">{{stats.pendingSign}}</text><text class="lbl">待签名</text></view>
        <view class="stat"><text class="num">{{stats.total}}</text><text class="lbl">评估记录</text></view>
      </view>
      <button wx:if="{{canCreate}}" class="btn-primary" bindtap="goNew">＋ 新建创面评估</button>
      <view wx:else class="ro-note">CRC 只读：创面评估须由研究者本人完成（GCP §4）</view>
    </view>

    <view class="section-title">最近评估</view>
    <view class="card" wx:if="{{recent.length === 0}}"><view class="empty">暂无评估记录</view></view>
    <view class="card" wx:for="{{recent}}" wx:key="_id" bindtap="goWound" data-wound="{{item.woundId}}" data-patient="{{item.patientId}}">
      <view class="list-item">
        <view class="li-main">
          <view class="li-title-row">
            <text class="li-title">{{item.subjectCode}} · {{item.woundLabel}}</text>
            <text class="tag {{item.status === 'locked' ? 'tag-green' : 'tag-orange'}}">{{item.status === 'locked' ? '已锁定' : '待签名'}}</text>
          </view>
          <text class="li-sub">面积 {{item.areaCm2}} cm² · {{item.createdAt}}</text>
        </view>
        <text class="arrow">›</text>
      </view>
    </view>

    <view wx:if="{{retentionUntil}}" class="card retention">
      <text class="retention-title">GCP 数据完整性</text>
      <text class="retention-body">数据留存至 {{retentionUntil}}（NMPA §63：试验完成后 10 年）</text>
    </view>
  </block>
</view>
