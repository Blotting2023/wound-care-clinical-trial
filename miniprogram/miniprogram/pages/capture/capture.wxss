.card-title { font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; }
.shot-empty {
  height: 360rpx; border-radius: 16rpx; background: #F5F5F7;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.shot-icon { font-size: 72rpx; }
.shot-text { font-size: 26rpx; color: #8E8E93; margin-top: 16rpx; }
.preview { width: 100%; height: 480rpx; border-radius: 16rpx; background: #000; }
.device-line { font-size: 22rpx; color: #8E8E93; margin-top: 12rpx; }
.exif-note { font-size: 22rpx; color: #34C759; margin-top: 8rpx; line-height: 1.5; }
