.card-title { font-size: 30rpx; font-weight: 600; margin-bottom: 12rpx; }
.auto-note { font-size: 24rpx; color: #0066CC; margin-top: 16rpx; }
.vss-item { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 0; }
.vss-label { font-size: 26rpx; }
.vss-scores { display: flex; }
.score {
  width: 64rpx; height: 64rpx; border-radius: 32rpx; background: #F5F5F7;
  display: flex; align-items: center; justify-content: center;
  margin-left: 12rpx; font-size: 26rpx; color: #8E8E93;
}
.score.on { background: #0066CC; color: #fff; font-weight: 600; }
