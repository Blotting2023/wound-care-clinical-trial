.sign-card { display: flex; flex-direction: column; align-items: center; padding: 64rpx 40rpx; }
.sign-icon { font-size: 80rpx; }
.sign-title { font-size: 36rpx; font-weight: 700; margin: 20rpx 0; }
.sign-meaning { font-size: 24rpx; color: #8E8E93; text-align: center; line-height: 1.6; margin-bottom: 40rpx; }
.pin-input {
  width: 100%; height: 96rpx; background: #F5F5F7; border-radius: 16rpx;
  text-align: center; font-size: 40rpx; letter-spacing: 12rpx; margin-bottom: 32rpx;
}
.sign-note { font-size: 22rpx; color: #8E8E93; margin-top: 24rpx; text-align: center; }
