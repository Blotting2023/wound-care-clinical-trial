.card-title { font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; }
.shot-empty { height: 280rpx; border-radius: 16rpx; background: #F5F5F7; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.shot-icon { font-size: 64rpx; }
.shot-text { font-size: 26rpx; color: #8E8E93; margin-top: 12rpx; }
.preview { width: 100%; height: 360rpx; border-radius: 16rpx; background: #000; margin-bottom: 8rpx; }
.pick-value { color: #1C1C1E; font-size: 28rpx; }
.c-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.c-time { font-size: 22rpx; color: #8E8E93; }
.c-photo { width: 100%; height: 280rpx; border-radius: 12rpx; }
.c-meta { display: block; font-size: 22rpx; color: #8E8E93; margin-top: 10rpx; }
.c-actions { display: flex; margin-top: 16rpx; }
.half { flex: 1; margin: 0 8rpx; font-size: 26rpx; padding: 4rpx 0; }
.half:first-child { margin-left: 0; }
.half:last-child { margin-right: 0; }
